# Wave_Agent paper-only LP profile. No wallet private keys.
STARTING_EQUITY_SOL=3
# USD conversion mark, or set PAPER_STARTING_EQUITY_USD directly.
SOL_PRICE_USD=
PAPER_STARTING_EQUITY_USD=
PAPER_STATE_PATH=./data/paper-state-lp.json

# Conservative balanced LP risk profile
MAX_RISK_PER_POSITION_PCT=0.003
MAX_PORTFOLIO_RISK_PCT=0.006
MAX_POSITION_ALLOCATION_PCT=0.125
MAX_OPEN_POSITIONS=2
MAX_DAILY_LOSS_PCT=1.5
MAX_DRAWDOWN_PCT=5
MAX_POOL_DATA_AGE_SEC=90
MAX_SECURITY_DATA_AGE_SEC=300
MIN_TVL_USD=25000
MIN_VOLUME_24H_USD=10000
MIN_FEE_APR_7D_PCT=40
MIN_FEE_APR_24H_PCT=35
MIN_EXPECTED_NET_EDGE_PCT=0.10
FEE_CAPTURE_SHARE=0.65
EXPECTED_HOLD_HOURS=168
ROUND_TRIP_COST_BPS=30
MAX_VOLATILITY_24H_PCT=7
MAX_STRESS_LOSS_PCT=8

# Helius read-only. Public address subscriptions only.
HELIUS_API_KEY=
HELIUS_RPC_URL=
