# Wave_Agent paper-only LP profile. No wallet private keys.
STARTING_EQUITY_SOL=3
# USD conversion mark, or set PAPER_STARTING_EQUITY_USD directly.
SOL_PRICE_USD=
PAPER_STARTING_EQUITY_USD=
PAPER_STATE_PATH=./data/paper-state-lp.json

# Conservative balanced LP risk profile
MAX_RISK_PER_POSITION_PCT=0.003
MAX_PORTFOLIO_RISK_PCT=0.006
MAX_POSITION_ALLOCATION_PCT=0.45
MAX_PORTFOLIO_UTILIZATION_PCT=0.90
HARD_STOP_LOSS_PCT=50
REBALANCE_QUOTE_MAX_AGE_SEC=30
MIN_WALLET_RANK_SCORE=65
REQUIRE_RANKED_LP_WALLETS=true
MAX_OPEN_POSITIONS=2
MAX_DAILY_LOSS_PCT=1.5
MAX_DRAWDOWN_PCT=5
MAX_POOL_DATA_AGE_SEC=90
MAX_TVL_USD=150000
MAX_MARKET_CAP_USD=10000000
MIN_ORGANIC_SCORE=60
MIN_QUOTE_ORGANIC_SCORE=60
MAX_BOT_HOLDERS_PCT=30
MIN_TOKEN_FEES_SOL=30
MIN_BIN_STEP=80
MAX_BIN_STEP=125
MIN_FEE_ACTIVE_TVL_RATIO=0.05
ALLOWED_LAUNCHPADS=
BLOCKED_LAUNCHPADS=
MAX_SECURITY_DATA_AGE_SEC=300

# Pair age, market cap, dilution, exit-liquidity and recent-flow filters
MIN_PAIR_AGE_DAYS=14
MAX_PAIR_EVIDENCE_AGE_SEC=120
MIN_MARKET_CAP_USD=250000
MAX_FDV_TO_MARKET_CAP=2.5
MIN_PAIR_LIQUIDITY_USD=50000
MIN_LIQUIDITY_TO_MARKET_CAP=0.08
MIN_TRANSACTIONS_24H=50
MIN_SELLS_24H=15
MIN_SELL_BUY_RATIO=0.35
MAX_SELL_BUY_RATIO=3.5
MIN_PAIR_CHANGE_24H_PCT=-18
MAX_PAIR_CHANGE_24H_PCT=45
MIN_TVL_USD=25000
MIN_VOLUME_24H_USD=10000
# Whole-pool APR is only a sanity filter, not the LP return estimate
MIN_POOL_FEE_APR_7D_PCT=60
MIN_POOL_FEE_APR_24H_PCT=50
# Proposed range's own simulated per-bin fee APR
MIN_POSITION_FEE_APR_7D_PCT=150
MIN_POSITION_FEE_APR_24H_PCT=120
# Require fees to cover 7d IL/inventory drag + round-trip costs with margin
MIN_EXPECTED_NET_EDGE_PCT=1.0
MIN_FEE_COVERAGE_RATIO=2.0
MAX_INVENTORY_DRAG_7D_PCT=1.0
FEE_CAPTURE_SHARE=0.65
EXPECTED_HOLD_HOURS=168
ROUND_TRIP_COST_BPS=30
MAX_VOLATILITY_24H_PCT=7
MAX_STRESS_LOSS_PCT=8

# Helius read-only. Public address subscriptions only.
HELIUS_API_KEY=
HELIUS_RPC_URL=
HELIUS_ENHANCED_URL=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
WATCH_WALLET_ADDRESS=
FALLBACK_RPC_URL=https://api.mainnet-beta.solana.com

# AI analyst only. It cannot authorize or override LP decisions.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://localhost
OPENROUTER_APP_NAME=Wave_Agent LP Analyst
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Meteora read-only inspector
METEORA_POOL_ADDRESS=
POLL_INTERVAL_SEC=60
BINS_EACH_SIDE=40

# Optional read-only indexers
BASE_UNISWAP_SUBGRAPH_URL=
BSC_PANCAKE_SUBGRAPH_URL=
ROBINHOOD_UNISWAP_SUBGRAPH_URL=
# GMGN Skills/MCP bridge key, when using the injected bridge adapter.
GMGN_API_KEY=
# The CLI adapter separately uses gmgn-cli's own configuration at ~/.config/gmgn/.env.
# Check it with: gmgn-cli config --check


# Optional long-running paper runtime. A separate local provider module must
# export createSnapshotProvider() with readOnly=true and getSnapshots().
PAPER_SNAPSHOT_PROVIDER_MODULE=
PAPER_RUNTIME_INTERVAL_MS=60000
