# Paper mode only. Never add wallet private keys.
STARTING_EQUITY_SOL=3
MAX_RISK_PER_POSITION_PCT=0.005
MIN_TVL_USD=25000
MIN_VOLUME_24H_USD=10000
MAX_OPEN_POSITIONS=2

# Helius Solana read-only infrastructure
HELIUS_API_KEY=
HELIUS_RPC_URL=
HELIUS_ENHANCED_URL=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional wallet monitor: public address only, never a private key.\nWATCH_WALLET_ADDRESS=\n# Fallback public RPC; use a dedicated provider for sustained monitoring.
FALLBACK_RPC_URL=https://api.mainnet-beta.solana.com

# OpenRouter-first AI. Select an exact active model slug in OpenRouter.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://localhost
OPENROUTER_APP_NAME=Meridian AI DLMM

# Optional OpenAI fallback. API billing is separate from ChatGPT subscription.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Meteora on-chain read-only monitor
METEORA_POOL_ADDRESS=
POLL_INTERVAL_SEC=60
BINS_EACH_SIDE=20

# Optional EVM indexers; do not fill until endpoints are verified.
BASE_UNISWAP_SUBGRAPH_URL=
BSC_PANCAKE_SUBGRAPH_URL=
ROBINHOOD_UNISWAP_SUBGRAPH_URL=

# GMGN is disabled until an approved official read-only bridge is configured.
GMGN_API_KEY=
